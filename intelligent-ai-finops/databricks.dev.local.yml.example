# EXAMPLE (copy to databricks.dev.local.yml, which is gitignored). Maintainer override for the `dev` target.
# Merged into databricks.yml via its `include: databricks.*.local.yml`. Holds the
# repo maintainer's real workspace values + the dev app-resource attachments so none
# of it ships in the repo. Customers do NOT use this file; they fill the `prod`
# target's variables in databricks.yml.
targets:
  dev:
    variables:
      warehouse_id: "<your-sql-warehouse-id>"
      # Autoscaling Lakebase project owned by this app (see V2_SETUP.md).
      lakebase_endpoint: "projects/<your-project>/branches/production/endpoints/primary"
      lakebase_host: "<your-endpoint>.database.<region>.cloud.databricks.com"
      lakebase_db: "databricks_postgres"
      tools_catalog: "<your-catalog>"
      tools_schema: "<your-schema>"
    # Native app-resource attachments: auto-grant the app SP access at deploy (no
    # manual grant SQL). Only valid because these resources EXIST in this workspace;
    # a blank/missing resource fails deploy, which is why they live here (maintainer)
    # not in the committed base app. Lakebase is NOT attached: autoscaling federates
    # the SP via `databricks postgres create-role ... SERVICE_PRINCIPAL` (V2_SETUP.md),
    # and the app connects with the LAKEBASE_ENDPOINT/HOST env.
    resources:
      apps:
        intelligent_ai_finops_v2:
          resources:
            - name: warehouse
              sql_warehouse:
                id: ${var.warehouse_id}
                permission: CAN_USE
            - name: embedding
              serving_endpoint:
                name: ${var.embed_endpoint}
                permission: CAN_QUERY
