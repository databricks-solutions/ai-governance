# Copy to .env for local dev. Nothing workspace-specific is hardcoded in the app.
# The target workspace is chosen by the CLI profile at deploy time (--profile),
# never here.

# Which Databricks CLI profile the backend uses when running LOCALLY (live mode).
# In a deployed Databricks App this is ignored — the app's service principal is used.
DATABRICKS_CONFIG_PROFILE=your-profile

# Demo mode: true = synthesize token counts / latency / judge server-side, no
# network (works offline / on venue wifi); false = call real Model Serving
# endpoints. Prices are the real DBU rate card either way. Local default true;
# app.yaml ships false so a deployed app gives real answers out of the box.
FINOPS_DEMO_MODE=true

# $ per DBU used to convert the FMAPI DBU rate card (config/models.yaml) into
# dollar prices. 0.07 = published AWS/GCP Model Serving list rate; set to the
# customer's negotiated $/DBU so shown prices match their contract.
FINOPS_DBU_TO_USD=0.07

# LLM-as-judge scoring (Compare tab). false hides the judge column.
FINOPS_JUDGE_ENABLED=true
