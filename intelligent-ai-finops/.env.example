# Copy to .env for local dev. Nothing workspace-specific is hardcoded in the app.
# The target workspace is chosen by the CLI profile (--profile) at deploy time.
# When deployed via the Asset Bundle, the app's env comes from databricks.yml
# (config.env, per target); these values are for running LOCALLY.

# Which Databricks CLI profile the backend uses when running locally (live mode).
# In a deployed Databricks App this is ignored (the app service principal is used).
DATABRICKS_CONFIG_PROFILE=your-profile

# Demo mode: true = synthesize numbers, no network (offline). false = call real
# Model Serving. Prices are the real DBU rate card either way. Live-first default
# ships false in app.yaml / databricks.yml; keep true locally if you want offline.
FINOPS_DEMO_MODE=true

# $ per DBU used to convert the FMAPI DBU rate card into dollar prices.
# 0.07 = published Model Serving list rate; set your negotiated $/DBU.
FINOPS_DBU_TO_USD=0.07

# LLM-as-judge scoring (Compare tab). false hides the judge column.
FINOPS_JUDGE_ENABLED=true

# ---- Optional: set these to test live system-table / cache / tools paths locally ----
# Cost tab source: system_tables (real) or demo.
FINOPS_DATA_SOURCE=demo
# Serverless SQL warehouse id the profile above can use.
FINOPS_WAREHOUSE_ID=
# Embedding endpoint for the semantic cache.
FINOPS_EMBED_ENDPOINT=databricks-gte-large-en
# Autoscaling Lakebase durable cache + semantic cache (optional; blank = in-process).
# LAKEBASE_ENDPOINT is the autoscaling endpoint path:
#   projects/<project>/branches/production/endpoints/primary
LAKEBASE_ENDPOINT=
LAKEBASE_HOST=
LAKEBASE_DB=databricks_postgres
# Real agent-tool functions (optional; blank = sample set).
FINOPS_TOOLS_CATALOG=
FINOPS_TOOLS_SCHEMA=
