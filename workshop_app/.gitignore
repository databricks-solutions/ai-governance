# Python
__pycache__/
*.py[cod]
.venv/
.env

# Node
node_modules/

# Built frontend. NOT committed: the minified single-line bundle is ~240KB, which
# dominates every diff and overflows code-review tooling. `bundle deploy` uploads
# whatever is in dist/, so build before deploying (npm ci && npm run build).
frontend/dist/

# Local config override
config/workshop.local.yaml

# Local npm config, if anyone sets one per-project. The sanctioned registry is the
# unauthenticated Databricks proxy (see README), so no token belongs here — but ignore it
# anyway so a credential can never be committed by accident.
frontend/.npmrc

# Databricks
.databricks/

# OS/IDE
.DS_Store
.vscode/
