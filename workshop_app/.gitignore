# Python
__pycache__/
*.py[cod]
.venv/
.env

# Node
node_modules/

# Built frontend. NOT committed: the minified single-line bundle is ~240KB, which
# dominates every diff and overflows code-review tooling. `bundle deploy` uploads
# whatever is in dist/, so build before deploying (npm ci && npm run build).
frontend/dist/

# Local config override
config/workshop.local.yaml

# npm registry credentials. Public registries are blocked by managed policy, so building
# here needs a JFrog token in frontend/.npmrc — that file holds a secret and must never be
# committed. See frontend/.npmrc.example for the template.
frontend/.npmrc

# Databricks
.databricks/

# OS/IDE
.DS_Store
.vscode/
