# npm registry config for building this frontend inside Databricks.
#
# Public registries (registry.npmjs.org, registry.yarnpkg.com, pypi.org, and many mirrors)
# are pinned to 127.0.0.1 in /etc/hosts by managed endpoint policy, so `npm install` against
# the default registry fails instantly with ECONNREFUSED. That is deliberate — the sanctioned
# path is the internal Artifactory mirror below, which is the same one CI uses.
#
# To use it:
#   1. Get a JFrog access token (Artifactory UI -> Edit Profile -> Generate an Identity Token,
#      or `jf c add` with the JFrog CLI).
#   2. cp .npmrc.example .npmrc
#   3. Replace <JFROG_ACCESS_TOKEN> below with it.
#   4. npm install && npm run build
#
# .npmrc is gitignored — never commit the token.

registry=https://databricks.jfrog.io/artifactory/api/npm/db-npm/
//databricks.jfrog.io/artifactory/api/npm/db-npm/:_authToken=<JFROG_ACCESS_TOKEN>
always-auth=true
